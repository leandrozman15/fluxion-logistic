rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permite lectura y escritura a cualquier usuario autenticado.
      // Se utiliza una regla global para asegurar que las fotos de perfil y documentos se carguen sin errores 403.
      allow read, write: if request.auth != null;
    }
  }
}