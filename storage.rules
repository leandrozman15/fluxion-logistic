rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permitir lectura y escritura a cualquier usuario autenticado en la plataforma.
      // En producción se recomienda segmentar: match /tenants/{tenantId}/{allPaths=**}
      allow read, write: if request.auth != null;
    }
  }
}