
{
  "firestore": {
    "collections": {
      "industryIndex": {
        "description": "Índice global de indústrias brasileiras para prospecção ativa",
        "schema": {
          "type": "object",
          "properties": {
            "companyName": { "type": "string" },
            "cnpj": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "industryTag": { "type": "string" },
            "cnae": { "type": "string" },
            "website": { "type": "string" },
            "employeesRange": { "type": "string" },
            "foundedYear": { "type": "number" },
            "isIndustrialHub": { "type": "boolean" }
          }
        }
      },
      "tenants": {
        "description": "Datos maestros de la organización/empresa",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "plan": { "type": "string", "enum": ["free", "pro"] },
            "settings": {
              "type": "object",
              "properties": {
                "scoringWeights": {
                  "type": "object",
                  "properties": {
                    "effective": { "type": "number" },
                    "ai": { "type": "number" }
                  }
                },
                "finalScoreMode": { "type": "string", "enum": ["weighted", "max"] },
                "dailyTopLimit": { "type": "number" },
                "requireContactMethod": { "type": "string", "enum": ["email_or_phone", "email_only", "none"] },
                "cooldownDays": { "type": "number" },
                "hourlyEmailLimit": { "type": "number" },
                "dailyEmailLimit": { "type": "number" },
                "defaultTemplateId": { "type": "string" }
              }
            }
          }
        },
        "documents": {
          "users": { "description": "Usuarios pertenecientes al tenant con roles" },
          "prospects": { "description": "Base de datos de leads industriais com histórico e auditoria" },
          "templates": { "description": "Plantillas de comunicação com suporte para variables" },
          "campaigns": { "description": "Configuração e estado de campaigns masivas" },
          "imports": { "description": "Registro de importaciones de arquivos CSV" },
          "dailyTop": { "description": "Ranking diario congelado de las melhores oportunidades (Top 30)" },
          "events": { "description": "Registro de telemetria e auditoría de acciones" },
          "dailyStats": { "description": "Estadísticas de uso, cuotas y métricas por dia" },
          "weeklyStats": { "description": "Métricas de conversión del pipeline por semana" },
          "segmentStats": { "description": "Inteligência de performance por segmento industrial" },
          "outbox": { "description": "Cola de mensagens operativos (draft, queued, sent, failed) com suporte para idempotencia" },
          "tasks": { 
            "description": "Tarefas de seguimento e ações pendentes por prospecto",
            "schema": {
              "type": "object",
              "properties": {
                "prospectId": { "type": "string" },
                "type": { "type": "string", "enum": ["followup_whatsapp", "followup_email", "call", "check_website"] },
                "dueAt": { "type": "string", "format": "date-time" },
                "state": { "type": "string", "enum": ["open", "done", "snoozed"] },
                "assignedTo": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" },
                "createdBy": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
