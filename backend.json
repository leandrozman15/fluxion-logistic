
{
  "firestore": {
    "collections": {
      "trucks": {
        "description": "Flota de camiones registrados",
        "schema": {
          "type": "object",
          "properties": {
            "plate": { "type": "string" },
            "brand": { "type": "string" },
            "model": { "type": "string" },
            "year": { "type": "number" },
            "capacityKg": { "type": "number" },
            "status": { "type": "string", "enum": ["available", "in_trip", "maintenance"] }
          }
        }
      },
      "drivers": {
        "description": "Choferes profesionales habilitados",
        "schema": {
          "type": "object",
          "properties": {
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "dni": { "type": "string" },
            "status": { "type": "string", "enum": ["active", "in_trip", "resting", "suspended"] }
          }
        }
      },
      "clients": {
        "description": "Cartera de clientes locales e internacionales",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "cuit": { "type": "string" },
            "comex": {
              "type": "object",
              "properties": {
                "countryOfOrigin": { "type": "string" },
                "impExpCode": { "type": "string" }
              }
            }
          }
        }
      },
      "loads": {
        "description": "Cargas y operaciones de flete nacional/internacional",
        "schema": {
          "type": "object",
          "properties": {
            "orderNumber": { "type": "string" },
            "clientName": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "assigned", "on_route", "delivered", "incident", "cancelled"] },
            "international": {
              "type": "object",
              "properties": {
                "operationType": { "type": "string" },
                "declarationNumber": { "type": "string" },
                "cifValueUsd": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
