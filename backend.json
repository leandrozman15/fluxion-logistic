
{
  "firestore": {
    "collections": {
      "trucks": {
        "description": "Flota de camiones registrados",
        "schema": {
          "type": "object",
          "properties": {
            "plate": { "type": "string" },
            "brand": { "type": "string" },
            "model": { "type": "string" },
            "year": { "type": "number" },
            "capacityKg": { "type": "number" },
            "status": { "type": "string", "enum": ["available", "in_trip", "maintenance"] }
          }
        }
      },
      "drivers": {
        "description": "Choferes profesionales habilitados",
        "schema": {
          "type": "object",
          "properties": {
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "dni": { "type": "string" },
            "status": { "type": "string", "enum": ["active", "in_trip", "resting", "suspended"] }
          }
        }
      },
      "loads": {
        "description": "Cargas y operaciones de flete",
        "schema": {
          "type": "object",
          "properties": {
            "orderNumber": { "type": "string" },
            "clientName": { "type": "string" },
            "description": { "type": "string" },
            "totalAmount": { "type": "number" },
            "status": { "type": "string", "enum": ["pending", "assigned", "on_route", "delivered", "incident", "cancelled"] }
          }
        }
      }
    }
  }
}
