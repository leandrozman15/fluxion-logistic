{
  "firestore": {
    "collections": {
      "tenants": {
        "description": "Datos maestros de la organización/empresa",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "plan": { "type": "string", "enum": ["free", "pro"] },
            "settings": {
              "type": "object",
              "properties": {
                "scoringWeights": {
                  "type": "object",
                  "properties": {
                    "effective": { "type": "number" },
                    "ai": { "type": "number" }
                  }
                },
                "finalScoreMode": { "type": "string", "enum": ["weighted", "max"] },
                "dailyTopLimit": { "type": "number" },
                "requireContactMethod": { "type": "string", "enum": ["email_or_phone", "email_only", "none"] },
                "cooldownDays": { "type": "number" },
                "hourlyEmailLimit": { "type": "number" },
                "dailyEmailLimit": { "type": "number" },
                "defaultTemplateId": { "type": "string" }
              }
            }
          }
        },
        "documents": {
          "users": { "description": "Usuarios pertenecientes al tenant con roles" },
          "prospects": { "description": "Base de datos de leads industriales con histórico y auditoría" },
          "templates": { "description": "Plantillas de comunicación con soporte para variables" },
          "campaigns": { "description": "Configuración y estado de campañas masivas" },
          "imports": { "description": "Registro de importaciones de archivos CSV" },
          "dailyTop": { "description": "Ranking diario congelado de las mejores oportunidades (Top 30)" },
          "dailyStats": { 
            "description": "Estadísticas de uso, cuotas y métricas por día",
            "schema": {
              "type": "object",
              "properties": {
                "date": { "type": "string" },
                "quotaUsed": { "type": "number" },
                "quotaLimit": { "type": "number" },
                "emailsSent": { "type": "number" },
                "emailsFailed": { "type": "number" },
                "radarAvgFinalScore": { "type": "number" },
                "newProspects": { "type": "number" }
              }
            }
          },
          "weeklyStats": {
            "description": "Métricas de conversión del pipeline por semana",
            "schema": {
              "type": "object",
              "properties": {
                "weekId": { "type": "string" },
                "statusChangedTo_contacted": { "type": "number" },
                "statusChangedTo_interested": { "type": "number" },
                "statusChangedTo_demo": { "type": "number" },
                "statusChangedTo_client": { "type": "number" }
              }
            }
          },
          "outbox": { "description": "Cola de mensajes operativos (draft, queued, sent, failed) con soporte para idempotencia" }
        }
      }
    }
  }
}