
{
  "firestore": {
    "collections": {
      "trucks": {
        "description": "Flota de camiones registrados",
        "schema": {
          "type": "object",
          "properties": {
            "plate": { "type": "string", "description": "Patente del vehículo (Argentina format)" },
            "model": { "type": "string" },
            "brand": { "type": "string" },
            "year": { "type": "number" },
            "capacityKg": { "type": "number" },
            "status": { "type": "string", "enum": ["available", "in_trip", "maintenance"] },
            "location": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "province": { "type": "string" }
              }
            }
          }
        }
      },
      "drivers": {
        "description": "Choferes habilitados",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "dni": { "type": "string" },
            "licenseNumber": { "type": "string" },
            "phone": { "type": "string" },
            "status": { "type": "string", "enum": ["active", "resting", "suspended"] }
          }
        }
      },
      "loads": {
        "description": "Cargas y pedidos de transporte",
        "schema": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "weightKg": { "type": "number" },
            "origin": { "type": "string" },
            "destination": { "type": "string" },
            "clientName": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "assigned", "on_route", "delivered"] },
            "priceArs": { "type": "number" }
          }
        }
      }
    }
  }
}
