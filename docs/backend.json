
{
  "firestore": {
    "collections": {
      "trucks": {
        "description": "Flota de veículos pesados com documentação e especificações técnicas.",
        "schema": {
          "type": "object",
          "properties": {
            "plate": { "type": "string" },
            "brand": { "type": "string" },
            "model": { "type": "string" },
            "year": { "type": "number" },
            "capacityKg": { "type": "number" },
            "status": { "type": "string", "enum": ["available", "in_trip", "maintenance"] },
            "location": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "province": { "type": "string" }
              }
            }
          }
        }
      },
      "drivers": {
        "description": "Choferes profissionais com licencias nacionais e habilitação LINTI.",
        "schema": {
          "type": "object",
          "properties": {
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "dni": { "type": "string" },
            "status": { "type": "string", "enum": ["active", "in_trip", "resting", "suspended"] }
          }
        }
      },
      "loads": {
        "description": "Órdenes de flete y transporte nacional.",
        "schema": {
          "type": "object",
          "properties": {
            "orderNumber": { "type": "string" },
            "clientName": { "type": "string" },
            "totalAmount": { "type": "number" },
            "status": { "type": "string", "enum": ["pending", "assigned", "on_route", "delivered", "incident", "cancelled"] }
          }
        }
      },
      "hubs": {
        "description": "Sedes y centros logísticos regionales.",
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "address": { "type": "string" },
            "city": { "type": "string" },
            "province": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "type": { "type": "string", "enum": ["hub", "warehouse", "office"] },
            "phone": { "type": "string" }
          },
          "required": ["name", "address", "lat", "lng"]
        }
      }
    }
  }
}
