{
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "collections": {
      "users": {
        "description": "Mapeo global de correos a organizaciones (Tenant Mapping).",
        "schema": {
          "type": "object",
          "properties": {
            "email": { "type": "string" },
            "tenantId": { "type": "string" },
            "role": { "type": "string" }
          }
        }
      },
      "tenants": {
        "description": "Lista de organizaciones registradas.",
        "schema": { "$ref": "#/backend/entities/Tenant" }
      },
      "tenants/{tenantId}/trucks": {
        "description": "Flota privada de la organización.",
        "schema": { "$ref": "#/backend/entities/Truck" }
      },
      "tenants/{tenantId}/drivers": {
        "description": "Personal de conducción y administración de la empresa.",
        "schema": { "$ref": "#/backend/entities/Driver" }
      },
      "tenants/{tenantId}/clients": {
        "description": "Cartera de clientes y destinos de la empresa.",
        "schema": { "$ref": "#/backend/entities/Client" }
      },
      "tenants/{tenantId}/loads": {
        "description": "Operaciones de flete de la organización.",
        "schema": { "$ref": "#/backend/entities/Load" }
      },
      "tenants/{tenantId}/products": {
        "description": "Catálogo de productos de la empresa.",
        "schema": { "$ref": "#/backend/entities/Product" }
      },
      "tenants/{tenantId}/hubs": {
        "description": "Sedes y bases operativas propias.",
        "schema": { "$ref": "#/backend/entities/Hub" }
      }
    }
  },
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "monthlyFee": { "type": "number" },
        "subscriptionStatus": { "type": "string" },
        "settings": { "type": "object" }
      }
    },
    "AppUser": {
      "title": "AppUser",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "tenantId": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  }
}