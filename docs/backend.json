
{
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "collections": {
      "trucks": {
        "description": "Flota de vehículos pesados con documentación y especificaciones técnicas.",
        "schema": { "$ref": "#/backend/entities/Truck" }
      },
      "drivers": {
        "description": "Choferes profissionais com licencias nacionais e habilitação LINTI.",
        "schema": { "$ref": "#/backend/entities/Driver" }
      },
      "clients": {
        "description": "Cartera de clientes dadores de carga con geolocalización de fachada.",
        "schema": { "$ref": "#/backend/entities/Client" }
      },
      "products": {
        "description": "Catálogo de artículos transportados con especificaciones logísticas y regulatorias (NCM/SENASA/ANMAT).",
        "schema": { "$ref": "#/backend/entities/Product" }
      },
      "loads": {
        "description": "Órdenes de flete y transporte regional.",
        "schema": { "$ref": "#/backend/entities/Load" }
      },
      "loads/{loadId}/expenses": {
        "description": "Gastos registrados durante el viaje por el conductor.",
        "schema": { "$ref": "#/backend/entities/Expense" }
      },
      "hubs": {
        "description": "Sedes y centros logísticos regionales.",
        "schema": { "$ref": "#/backend/entities/Hub" }
      },
      "maintenance": {
        "description": "Registros de mantenimiento preventivo y correctivo de la flota.",
        "schema": { "$ref": "#/backend/entities/Maintenance" }
      }
    }
  },
  "entities": {
    "Truck": {
      "title": "Truck",
      "type": "object",
      "properties": {
        "plate": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Driver": {
      "title": "Driver",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "dni": { "type": "string" }
      }
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cuit": { "type": "string" },
        "facadePhotoUrl": { "type": "string" },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "number": { "type": "string" },
            "barrio": { "type": "string" },
            "city": { "type": "string" },
            "province": { "type": "string" },
            "zip": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unitWeightKg": { "type": "number" },
        "unitVolumeM3": { "type": "number" },
        "ncmCode": { "type": "string" },
        "requiresReefer": { "type": "boolean" },
        "dangerLevel": { "type": "string" }
      }
    },
    "Load": {
      "title": "Load",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "status": { "type": "string" },
        "budget": {
          "type": "object",
          "properties": {
            "initialAdvance": { "type": "number" },
            "totalBudget": { "type": "number" }
          }
        }
      }
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Hub": {
      "title": "Hub",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "Maintenance": {
      "title": "Maintenance",
      "type": "object",
      "properties": {
        "truckId": { "type": "string" },
        "type": { "type": "string", "enum": ["preventive", "corrective", "inspection"] },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "description": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "completedDate": { "type": "string" },
        "odometerAtMaintenance": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "actualCost": { "type": "number" },
        "workshopName": { "type": "string" }
      }
    }
  }
}
