
{
  "firestore": {
    "collections": {
      "trucks": {
        "description": "Flota de vehículos pesados con documentación y especificaciones técnicas.",
        "schema": {
          "type": "object",
          "properties": {
            "plate": { "type": "string" },
            "brand": { "type": "string" },
            "model": { "type": "string" },
            "year": { "type": "number" },
            "capacityKg": { "type": "number" },
            "status": { "type": "string", "enum": ["available", "in_trip", "maintenance"] },
            "location": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "province": { "type": "string" }
              }
            },
            "documentation": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "status": { "type": "string" },
                  "expiryDate": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "drivers": {
        "description": "Choferes profesionales con licencias nacionales y habilitación LINTI.",
        "schema": {
          "type": "object",
          "properties": {
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "dni": { "type": "string" },
            "status": { "type": "string", "enum": ["active", "in_trip", "resting", "suspended"] },
            "licenseExpiry": { "type": "string" },
            "hasLinti": { "type": "boolean" },
            "lintiExpiry": { "type": "string" }
          }
        }
      },
      "loads": {
        "description": "Órdenes de flete y transporte nacional.",
        "schema": {
          "type": "object",
          "properties": {
            "orderNumber": { "type": "string" },
            "clientName": { "type": "string" },
            "totalAmount": { "type": "number" },
            "status": { "type": "string", "enum": ["pending", "assigned", "on_route", "delivered", "incident", "cancelled"] },
            "origin": { "type": "object" },
            "destination": { "type": "object" }
          }
        }
      }
    }
  }
}
