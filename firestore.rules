
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user belongs to tenant
    function belongsToTenant(tenantId) {
      let rootUserPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let tenantUserPath = /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
      
      return isSignedIn() && (
        exists(tenantUserPath) ||
        (exists(rootUserPath) && get(rootUserPath).data.tenantId == tenantId)
      );
    }

    function getUserRole(tenantId) {
      let rootUser = /databases/$(database)/documents/users/$(request.auth.uid);
      let tenantUser = /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
      
      return exists(tenantUser) ? get(tenantUser).data.role : 
             (exists(rootUser) ? get(rootUser).data.role : 'viewer');
    }

    function hasRole(tenantId, role) {
      let userRole = getUserRole(tenantId);
      return userRole == role || userRole == 'admin';
    }

    // Root profile MUST be first to avoid conflicts
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global Industry Index - Accessible to all industrial users
    match /industryIndex/{docId} {
      allow read: if isSignedIn();
    }

    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if hasRole(tenantId, 'admin');

      match /users/{userId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'admin');
      }

      match /prospects/{prospectId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if belongsToTenant(tenantId);
        allow update: if belongsToTenant(tenantId);
        allow delete: if hasRole(tenantId, 'admin');
      }

      match /tasks/{taskId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /templates/{templateId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /campaigns/{campaignId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /sequences/{sequenceId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /sequenceEnrollments/{enrollmentId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /outbox/{messageId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if belongsToTenant(tenantId);
        allow update: if belongsToTenant(tenantId);
        allow delete: if hasRole(tenantId, 'admin');
      }

      match /events/{eventId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if belongsToTenant(tenantId);
      }

      match /imports/{importId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }
      
      match /dailyStats/{date} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /weeklyStats/{weekId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /dailyTop/{date} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'admin');
      }

      match /segmentStats/{segmentId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }
    }
  }
}
