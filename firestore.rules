rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función para identificar al Super Administrador global
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'leozman15@gmail.com';
    }

    // Valida si existe el perfil del usuario
    function hasProfile() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()));
    }

    // Obtiene los datos del perfil del usuario de forma segura
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data;
    }

    // Valida si el usuario pertenece al tenant o es SuperAdmin
    function belongsToTenant(tenantId) {
      return request.auth != null && (
        isSuperAdmin() || 
        (hasProfile() && getUserProfile().tenantId == tenantId)
      );
    }

    // Colección global de mapeo: permite saber a qué empresa pertenece un email
    match /users/{email} {
      allow read: if request.auth != null;
      // Permite escribir si es SuperAdmin o si es un Gerente creando un usuario para su propia empresa
      allow write: if isSuperAdmin() || (
        hasProfile() && 
        getUserProfile().role in ['manager', 'admin'] && 
        request.resource.data.tenantId == getUserProfile().tenantId
      );
    }

    // Reglas maestras de Organizaciones (Tenants)
    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isSuperAdmin();

      // AISLAMIENTO TOTAL: Toda la data operativa vive aquí dentro
      match /{allPaths=**} {
        allow read, write: if belongsToTenant(tenantId);
      }
    }

    // Bloqueo por defecto para rutas no mapeadas
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}