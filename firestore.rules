rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
    =====================================================
    MODO DE TESTE ABERTO (OPEN TEST MODE)
    =====================================================
    Este modo permite que qualquer pessoa acesse e edite
    os dados para facilitar a homologação.
    As restrições de isolamento serão reativadas após os testes.
    =====================================================
    */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}