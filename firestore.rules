rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
    =====================================================
    MODO TESTE TOTALMENTE ABERTO (PRODUCTION UNLOCKED)
    =====================================================
    Este modo permite acesso irrestrito para facilitar 
    testes e homologação rápida sem burocracia de perfis.
    =====================================================
    */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}