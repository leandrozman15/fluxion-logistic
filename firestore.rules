rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
    =====================================================
    MODO TOTALMENTE ABERTO (PRODUCTION UNLOCKED)
    =====================================================
    Este modo permite que qualquer pessoa acesse e edite
    os dados sem qualquer autenticação ou autorização.
    =====================================================
    */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}