
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función para verificar si el usuario pertenece al tenant
    function isSignedIn() {
      return request.auth != null;
    }
    
    function belongsToTenant(tenantId) {
      return isSignedIn() && 
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId);
    }

    function getUserData(tenantId) {
      // Intentar obtener de la subcolección o del mapeo raíz
      let userInTenant = /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
      return exists(userInTenant) ? get(userInTenant).data : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(tenantId, role) {
      let userData = getUserData(tenantId);
      return userData.role == role || userData.role == 'admin';
    }

    // Reglas para el Tenant
    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if hasRole(tenantId, 'admin');

      match /users/{userId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'admin');
      }

      match /prospects/{prospectId} {
        allow read: if belongsToTenant(tenantId);
        allow create, update: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
        allow delete: if hasRole(tenantId, 'admin');
      }

      match /templates/{templateId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'sales');
      }

      match /campaigns/{campaignId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'sales');
      }

      match /outbox/{messageId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
        allow update: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales') 
          && (request.resource.data.state in ['draft', 'queued', 'canceled'])
          && (request.resource.data.attempts == resource.data.attempts);
        allow delete: if hasRole(tenantId, 'admin');
      }

      match /imports/{importId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'sales');
      }
      
      match /dailyStats/{date} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId); // Permitido para actualizaciones de cuota vía transacción
      }

      match /dailyTop/{date} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'admin');
      }
    }

    // Colección raíz para mapeo uid -> tenantId (Seguridad extra)
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if false;
    }
  }
}
