
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user belongs to tenant via root /users/{uid} or tenants/{id}/users/{uid}
    function belongsToTenant(tenantId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    // Get role from either location
    function getUserRole(tenantId) {
      let rootUser = /databases/$(database)/documents/users/$(request.auth.uid);
      let tenantUser = /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
      
      return exists(tenantUser) ? get(tenantUser).data.role : 
             (exists(rootUser) ? get(rootUser).data.role : 'viewer');
    }

    function hasRole(tenantId, role) {
      let userRole = getUserRole(tenantId);
      return userRole == role || userRole == 'admin';
    }

    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if hasRole(tenantId, 'admin');

      match /users/{userId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'admin');
      }

      match /prospects/{prospectId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
        allow update: if belongsToTenant(tenantId) && (
          hasRole(tenantId, 'sales') || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'status', 'updatedAt', 'doNotContact', 'doNotContactReason', 'doNotContactAt'])
        );
        allow delete: if hasRole(tenantId, 'admin');
      }

      match /templates/{templateId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
      }

      match /campaigns/{campaignId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
      }

      match /outbox/{messageId} {
        allow read: if belongsToTenant(tenantId);
        allow create: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
        allow update: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales') 
          && (request.resource.data.state in ['draft', 'queued', 'canceled']);
        allow delete: if hasRole(tenantId, 'admin');
      }

      match /imports/{importId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId) && hasRole(tenantId, 'sales');
      }
      
      match /dailyStats/{date} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /weeklyStats/{weekId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }

      match /dailyTop/{date} {
        allow read: if belongsToTenant(tenantId);
        allow write: if hasRole(tenantId, 'admin');
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
