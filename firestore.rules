rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función para identificar al Super Administrador global
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'leozman15@gmail.com';
    }

    // Obtiene los datos del perfil del usuario (vinculado por email para pre-registro)
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    // Valida si el usuario pertenece al tenant que intenta acceder
    function belongsToTenant(tenantId) {
      return request.auth != null && (isSuperAdmin() || getUserProfile().tenantId == tenantId);
    }

    // Reglas para la colección global de mapeo de usuarios
    match /users/{email} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Reglas para la colección de organizaciones (Tenants)
    match /tenants/{tenantId} {
      // Solo miembros de la empresa o SuperAdmin pueden leer la config del tenant
      allow read: if belongsToTenant(tenantId);
      allow write: if isSuperAdmin();

      // Reglas para subcolecciones de la empresa (aislamiento total)
      match /{allSubcollections=**} {
        allow read, write: if belongsToTenant(tenantId);
      }
    }

    // Reglas para colecciones operativas (Compatibilidad con modo actual mientras se migran a subcolecciones)
    // Para una seguridad total, estas deberían estar dentro de /tenants/{tenantId}/...
    match /trucks/{docId} { allow read, write: if request.auth != null; }
    match /drivers/{docId} { allow read, write: if request.auth != null; }
    match /clients/{docId} { allow read, write: if request.auth != null; }
    match /products/{docId} { allow read, write: if request.auth != null; }
    match /loads/{docId} { allow read, write: if request.auth != null; }
    match /hubs/{docId} { allow read, write: if request.auth != null; }
    match /maintenance/{docId} { allow read, write: if request.auth != null; }
    match /pending_remitos/{docId} { allow read, write: if request.auth != null; }
    match /global_expenses/{docId} { allow read, write: if request.auth != null; }

    // Bloqueo total para cualquier otra ruta no definida
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}