rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
    =====================================================
    CORE SECURITY MODEL
    =====================================================
    - Strict multi-tenant isolation
    - All business data lives under /tenants/{tenantId}
    - Access requires membership in /tenants/{tenantId}/users/{uid}
    =====================================================
    */

    // ---------------------------------------------------
    // BASIC AUTH HELPERS
    // ---------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ---------------------------------------------------
    // TENANT MEMBERSHIP
    // ---------------------------------------------------

    function tenantUserPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/users/$(uid());
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && (
        exists(tenantUserPath(tenantId)) || 
        (exists(/databases/$(database)/documents/users/$(uid())) && get(/databases/$(database)/documents/users/$(uid())).data.tenantId == tenantId)
      );
    }

    function tenantUser(tenantId) {
      return exists(tenantUserPath(tenantId)) ? get(tenantUserPath(tenantId)).data : get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isTenantAdmin(tenantId) {
      let user = tenantUser(tenantId);
      return belongsToTenant(tenantId) && (
        user.role == "admin" || 
        (user.get('roles', []).hasAny(["admin"]))
      );
    }

    // ---------------------------------------------------
    // ROOT USER PROFILES (Critical for Tenant Lookup)
    // ---------------------------------------------------

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ---------------------------------------------------
    // TENANT ROOT
    // ---------------------------------------------------

    match /tenants/{tenantId} {
      allow get: if belongsToTenant(tenantId);
      allow list: if isSignedIn();
      allow create: if isSignedIn(); // Bootstrap allowed
      allow update: if isTenantAdmin(tenantId);
      allow delete: if false;

      // ---------------------------------------------------
      // TENANT USERS
      // ---------------------------------------------------
      match /users/{userId} {
        allow get, list: if belongsToTenant(tenantId);
        allow create: if isOwner(userId) || isTenantAdmin(tenantId);
        allow update: if isOwner(userId) || isTenantAdmin(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      // ---------------------------------------------------
      // BUSINESS COLLECTIONS
      // ---------------------------------------------------
      
      match /prospects/{prospectId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      match /campaigns/{campaignId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      match /templates/{templateId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      match /outbox/{messageId} {
        allow read, create, update: if belongsToTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /imports/{importId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      match /dailyTop/{dateId} {
        allow read, create, update: if belongsToTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /dailyStats/{dateId} {
        allow read, create, update: if belongsToTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /segmentStats/{segmentId} {
        allow read, create, update: if belongsToTenant(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /events/{eventId} {
        allow read, create: if belongsToTenant(tenantId);
      }

      match /tasks/{taskId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      match /sequences/{sequenceId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      match /sequenceEnrollments/{enrollmentId} {
        allow read, write: if belongsToTenant(tenantId);
      }
    }

    // ---------------------------------------------------
    // GLOBAL INDUSTRY INDEX (Radar Nacional)
    // ---------------------------------------------------

    match /industryIndex/{companyId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}