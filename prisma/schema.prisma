generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String     @id @default(cuid())
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String     @unique
  phone     String?
  address   String?
  company   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]

  @@index([tenantId, createdAt])
}

model Driver {
  id                       String       @id @default(cuid())
  tenantId                 String?
  tenant                   Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String
  email                    String       @unique
  phone                    String?
  licenseNumber            String?
  active                   Boolean      @default(true)
  role                     DriverRole   @default(driver)
  status                   DriverStatus @default(active)
  docType                  String?
  dni                      String?
  firstName                String?
  lastName                 String?
  birthDate                String?
  gender                   String?
  nationality              String?
  licenseClasses           String[]     @default([])
  licenseExpiry            String?
  hasLinti                 Boolean      @default(false)
  lintiNumber              String?
  lintiExpiry              String?
  hasCnrt                  Boolean      @default(false)
  cnrtNumber               String?
  medicalCertificateExpiry String?
  experienceYears          Int?
  emergencyContact         String?
  emergencyPhone           String?
  address                  String?
  bloodType                String?
  healthInsurance          String?
  medicalConditions        String?
  hireDate                 String?
  contractType             String?
  observations             String?
  avatarUrl                String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  shipments                Shipment[]
  assignedTrucks           Truck[]      @relation("TruckAssignedDriver")
  loads                    Load[]       @relation("LoadAssignedDriver")
  Expense                  Expense[]

  @@index([tenantId, status])
}

model Vehicle {
  id         String     @id @default(cuid())
  plate      String     @unique
  brand      String?
  model      String?
  year       Int?
  capacityKg Int?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  shipments  Shipment[]
}

model Shipment {
  id           String   @id @default(cuid())
  trackingCode String   @unique
  status       String   @default("CREATED")
  origin       String?
  destination  String?
  customerId   String
  driverId     String?
  vehicleId    String?
  customer     Customer @relation(fields: [customerId], references: [id])
  driver       Driver?  @relation(fields: [driverId], references: [id])
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum DriverRole {
  admin
  sales_admin
  purchasing_admin
  coordinator
  manager
  warehouse
  driver
  companion
  viewer
}

enum DriverStatus {
  active
  in_trip
  resting
  suspended
  retired
}

enum TruckStatus {
  available
  in_trip
  maintenance
}

enum OwnershipType {
  company
  third_party
}

enum HubType {
  hub
  warehouse
  office
}

enum LoadStatus {
  pending
  assigned
  on_route
  on_pause
  delivered
  incident
  cancelled
  archived
}

enum ExpenseCategory {
  fuel
  toll
  meal
  lodging
  maintenance
  other
}

enum QuotationStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
  ordered
}

enum ClientStatus {
  active
  inactive
}

enum ProductStatus {
  active
  inactive
  suspended
}

enum StockMovementType {
  in
  out
  adjustment
}

model Tenant {
  id                 String      @id @default(cuid())
  name               String
  plan               String      @default("free")
  monthlyFee         Decimal     @default(0) @db.Decimal(12, 2)
  subscriptionStatus String      @default("active")
  activationDate     String?
  expirationDate     String?
  settings           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  users              AppUser[]
  drivers            Driver[]
  customers          Customer[]
  clients            Client[]
  trucks             Truck[]
  hubs               Hub[]
  loads              Load[]
  expenses           Expense[]
  quotations         Quotation[]
  products           Product[]
}

model AppUser {
  id          String     @id @default(cuid())
  uid         String     @unique
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  displayName String?
  role        DriverRole @default(viewer)
  status      String     @default("active")
  lastLogin   DateTime?
  createdAt   DateTime   @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Client {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  internalCode         String?
  name                 String
  cuit                 String
  address              Json
  mainContact          Json
  industry             String?
  facadePhotoUrl       String?
  status               ClientStatus @default(active)
  creditLimit          Decimal      @default(0) @db.Decimal(12, 2)
  defaultPaymentMethod String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  loads                Load[]
  quotations           Quotation[]

  @@unique([tenantId, cuit])
  @@index([tenantId, name])
}

model Truck {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plate                 String
  brand                 String?
  model                 String?
  year                  Int?
  axles                 Int?
  grossCombinedWeightKg Int?
  unladenWeightKg       Int?
  capacityKg            Int?
  odometerKm            Int?
  avgConsumption        Float?
  status                TruckStatus   @default(available)
  hasActiveAlert        Boolean       @default(false)
  alertType             String?
  ownershipType         OwnershipType @default(company)
  haulingType           String        @default("standard")
  location              Json?
  assignedDriverId      String?
  assignedDriver        Driver?       @relation("TruckAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedCompanionIds  String[]      @default([])
  avatarUrl             String?
  documentation         Json?
  semiTrailer           Json?
  bitren                Json?
  costs                 Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  loads                 Load[]        @relation("LoadAssignedTruck")
  maintenances          Maintenance[]
  Expense               Expense[]

  @@unique([tenantId, plate])
  @@index([tenantId, status])
}

model Hub {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String
  city        String
  province    String
  country     String
  lat         Float
  lng         Float
  type        HubType           @default(hub)
  phone       String?
  isMainBase  Boolean           @default(false)
  loadingBays Json?
  settings    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  layouts     WarehouseLayout[]

  @@index([tenantId, type])
}

model Load {
  id                         String     @id @default(cuid())
  tenantId                   String
  tenant                     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber                String
  serviceType                String     @default("standard")
  clientName                 String
  clientId                   String?
  client                     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedDriverId           String?
  assignedDriver             Driver?    @relation("LoadAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedTruckId            String?
  assignedTruck              Truck?     @relation("LoadAssignedTruck", fields: [assignedTruckId], references: [id], onDelete: SetNull)
  isRoundTrip                Boolean    @default(false)
  pickupDate                 String
  pickupTime                 String
  estimatedArrivalDate       String
  estimatedArrivalTime       String
  returnPickupDate           String?
  returnPickupTime           String?
  returnEstimatedArrivalDate String?
  returnEstimatedArrivalTime String?
  origin                     Json
  destination                Json?
  outboundStops              Json
  returnStops                Json?
  returnDestination          Json?
  international              Json?
  budget                     Json?
  invoiceNumber              String?
  basePrice                  Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount                Decimal    @default(0) @db.Decimal(12, 2)
  status                     LoadStatus @default(pending)
  dockEntryAuthorized        Boolean?
  dockEntryMessage           String?
  tracking                   Json?
  proofOfDelivery            Json?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  expenses                   Expense[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
}

model Maintenance {
  id                    String   @id @default(cuid())
  truckId               String
  truck                 Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  orderNumber           String
  type                  String
  status                String
  description           String
  scheduledDate         String
  completedDate         String?
  odometerAtMaintenance Int?
  estimatedCost         Decimal  @default(0) @db.Decimal(12, 2)
  actualCost            Decimal? @db.Decimal(12, 2)
  workshopName          String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([truckId])
}

model Expense {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loadId        String
  load          Load            @relation(fields: [loadId], references: [id], onDelete: Cascade)
  truckId       String?
  truck         Truck?          @relation(fields: [truckId], references: [id], onDelete: SetNull)
  driverId      String?
  driver        Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("ARS")
  description   String
  location      String?
  receiptNumber String?
  docsPresented Boolean?
  status        String          @default("registered")
  liters        Float?
  pricePerLiter Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, category])
}

model Quotation {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number             String
  date               String
  expiryDate         String
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName         String
  clientCuit         String
  ivaCondition       String
  branchId           String?
  sellerId           String?
  sellerName         String?
  priceListId        String?
  currency           String          @default("ARS")
  exchangeRate       Decimal         @default(1) @db.Decimal(12, 4)
  subtotal           Decimal         @default(0) @db.Decimal(12, 2)
  commercialDiscount Decimal         @default(0) @db.Decimal(12, 2)
  logisticSurcharge  Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2)
  includeTransport   Boolean         @default(false)
  transportPaidBy    String          @default("company")
  freightValue       Decimal         @default(0) @db.Decimal(12, 2)
  deliveryType       String?
  deliveryAddress    String?
  paymentMethod      String?
  paymentTerm        String?
  deliveryTimeDays   Int?
  warrantyInfo       String?
  status             QuotationStatus @default(draft)
  notes              String?
  internalNotes      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  items              QuotationItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?
  sku             String
  name            String
  quantity        Int
  unit            String
  unitPrice       Decimal   @default(0) @db.Decimal(12, 2)
  discountPercent Float     @default(0)
  ivaRate         Float     @default(21)
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @default(0) @db.Decimal(12, 2)
  photoUrl        String?
  warehouseId     String?

  @@index([quotationId])
}

model Product {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                String
  gtin               String?
  name               String
  shortName          String?
  brand              String?
  model              String?
  manufacturer       String?
  description        String?
  category           String?
  subCategory        String?
  productLine        String?
  family             String?
  afipRubro          String?
  unitWeightKg       Float?
  dimensions         Json?
  unitVolumeM3       Float?
  unitType           String?
  conversionFactor   Float?
  packagingType      String?
  unitsPerBox        Int?
  cajasPerPallet     Int?
  unitsPerPallet     Int?
  stockQuantity      Int             @default(0)
  minStockAlert      Int?
  maxStockAlert      Int?
  managesStock       Boolean         @default(true)
  allowNegativeStock Boolean         @default(false)
  isLotTracked       Boolean         @default(false)
  isSerialTracked    Boolean         @default(false)
  expiryControl      Boolean         @default(false)
  hasVariants        Boolean         @default(false)
  variants           Json?
  warehouses         Json?
  mainSupplierId     String?
  altSupplierId      String?
  supplierCode       String?
  lastCost           Decimal?        @db.Decimal(12, 2)
  avgCost            Decimal?        @db.Decimal(12, 2)
  currency           String?
  markup             Float?
  listPrice          Decimal?        @db.Decimal(12, 2)
  wholesalePrice     Decimal?        @db.Decimal(12, 2)
  wholesaleDiscount  Float?
  distributorPrice   Decimal?        @db.Decimal(12, 2)
  retailPrice        Decimal?        @db.Decimal(12, 2)
  ivaRate            Float           @default(21)
  ncmCode            String?
  origin             String          @default("nacional")
  dangerLevel        String          @default("none")
  onuNumber          String?
  requiresReefer     Boolean         @default(false)
  tempRange          Json?
  status             ProductStatus   @default(active)
  photoUrl           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  stockMovements     StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String
  referenceId   String?
  actorEmail    String?
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
}

model WarehouseLayout {
  id        String   @id @default(cuid())
  hubId     String
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  name      String
  sections  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([hubId])
}
