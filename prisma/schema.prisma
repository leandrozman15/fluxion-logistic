generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  phone     String?
  address   String?
  company   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]
}

model Driver {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String?
  licenseNumber String?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  shipments     Shipment[]
}

model Vehicle {
  id         String     @id @default(cuid())
  plate      String     @unique
  brand      String?
  model      String?
  year       Int?
  capacityKg Int?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  shipments  Shipment[]
}

model Shipment {
  id           String   @id @default(cuid())
  trackingCode String   @unique
  status       String   @default("CREATED")
  origin       String?
  destination  String?
  customerId   String
  driverId     String?
  vehicleId    String?
  customer     Customer @relation(fields: [customerId], references: [id])
  driver       Driver?  @relation(fields: [driverId], references: [id])
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
